# Copy to deploy/cx22/.env on the box, chmod 600. Never commit the real file.
# This repository is public: every deployment-specific value lives here, not in
# a tracked file. The private runbook has them.
#
# PGPASSWORD is generated ON the box (`openssl rand -hex 24`) and is the same
# value the postgres container initialises with. checkers has no other secret:
# the API takes only PG* and the web image takes no configuration at all.
PGPASSWORD=

# The co-tenant compose project's docker network, which we join as external so
# the shared front door can reach these containers by name.
SHARED_NETWORK=

# Off-box backup destination. BACKUP_S3_ENV points at a separate 0600 file of
# rclone environment variables (type, provider, endpoint, REGION, access key,
# secret key); BACKUP_S3_REMOTE is the rclone path dumps are copied to.
#
# REGION is the line that is easy to leave out and hard to diagnose: Hetzner
# Object Storage answers reads without it and rejects every PUT with
# LocationConstraintConflict, so `rclone ls` succeeds while the backup silently
# never leaves the box. 2026-09-07: cost an hour the first time.
BACKUP_S3_ENV=
BACKUP_S3_REMOTE=
